{
  "name": "@crispstrobe/crispbasic",
  "version": "0.1.0-dev.2",
  "private": true,
  "description": "CrispBASIC: a portable BBC BASIC-compatible runtime with native and restricted headless WASM backends.",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.mjs",
    "./native": "./src/native-session.mjs",
    "./source": "./src/source.mjs",
    "./wasm": "./src/wasm-session.mjs",
    "./browser": "./browser.mjs"
  },
  "bin": {
    "crispbasic": "./bin/crispbasic.mjs"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test tests/source.test.mjs",
    "test:native": "node --test tests/runtime.test.mjs tests/cli.test.mjs",
    "test:all": "npm test && npm run test:native && npm run test:wasm && npm run test:parity",
    "start": "node bin/crispbasic.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node --test tests/wasm-runtime.test.mjs tests/wasm-policy.test.mjs",
    "test:parity": "node --test tests/parity.test.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
