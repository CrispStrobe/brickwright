node_modules/
# the SLASHLESS form too: a node_modules SYMLINK is invisible to the
# trailing-slash rule, and one committed from a Mac (absolute target)
# broke CI's module census — the same trap bw-board fixed at de7c51e
node_modules
# Vendored permissive sources (populated by `npm run vendor`). Kept out of git initially;
# once you start editing a component, `git add -f packages/<name>` to own it in-tree.
packages/scratch-gui/
packages/scratch-vm/
packages/scratch-blocks/
packages/scratch-paint/
packages/scratch-render/
packages/scratch-audio/
packages/scratch-storage/
packages/scratch-svg-renderer/
build/
!overlay/scratch-gui/static/microbit-sim/build/
dist/
# NQC as WASM is TRACKED, despite `dist/` above: it is a vendored MPL-2.0
# compiler that must ship, not a build artefact of this repo. smallerc-wasm's
# dist is tracked the same way, but by a force-add, which leaves no trace of
# the decision anywhere a reader would look. This says it out loud instead.
!overlay/scratch-gui/src/lib/nqc-wasm/dist/
!overlay/scratch-gui/src/lib/nqc-wasm/dist/**
/tmp/
*.tgz
.vercel

# micro:bit firmware build outputs
out/

# Agent context (local only)
CLAUDE.md
.claude/
.last-run.json

# Gate output — screenshots, rendered schematic corpora. Written by
# scripts/verify-*.mjs and render-schematic.mjs, never an input to anything.
# Ignored specifically so it cannot be swept in by a `git add -A`: that is how
# a 21 MB wasm blob got committed in bw-board (LABWIRED-BRIDGE.md §7), and this
# directory now collects PNGs on every browser-gate run.
/artifacts/

# node --test per-file census output (scripts/check-test-run.mjs reads it; never an input)
/test-results/

# The standalone compiler packager fetches immutable Git objects here.
# This cache is generated locally; the reviewed commit and hashes are tracked.
/.build/crispbasic-compiler/

# SDCC is GPL-2.0-or-later and this repository is BSD-3-Clause. The compiler
# is fetched from https://github.com/CrispStrobe/sdcc-wasm when a user opts in,
# and by CI for the Node gates. It must never be committed here again.
overlay/scratch-gui/src/lib/sdcc-wasm/dist/
packages/scratch-gui/src/lib/sdcc-wasm/dist/

# SPIKE audit records and execution transcripts belong in the private evidence repository.
/docs/independent-spike/evidence/
/tools/*
!/tools/model-api/
/tools/model-api/node_modules/
/tools/model-api/.env*

# Private machine-specific Arcade agent handoff (never publish).
/docs/ARCADE-AGENT-HANDOFF.local.md
